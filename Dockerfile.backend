# yt-transcripts FastAPI backend.
FROM python:3.12-slim
WORKDIR /app
# ffmpeg so yt-dlp can extract audio; tzdata so named timezones resolve, which the
# watcher needs to run its check windows in local time rather than UTC.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg tzdata && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
ENV YT_TRANSCRIPTS_HOST=0.0.0.0
ENV YT_TRANSCRIPTS_DATA_DIR=/app/data
ENV TRANSCRIPT_STORE_BACKEND=sqlite
ENV PYTHONUNBUFFERED=1
EXPOSE 8000 8001
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
